rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc().data.active == true; }
    function hasRole(roles) { return isActive() && userDoc().data.role in roles; }
    function treasurer() { return hasRole(['ADMIN', 'TREASURER']); }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if hasRole(['ADMIN']);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow update: if hasRole(['ADMIN']) && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedAt'])
        && request.resource.data.role in ['ADMIN', 'TREASURER', 'VIEWER'];
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if signedIn();
      allow create, update: if treasurer();
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn();
      allow create: if treasurer() && request.resource.data.type in ['INCOME', 'EXPENSE'] && request.resource.data.amount is int && request.resource.data.amount > 0;
      allow update: if treasurer();
      allow delete: if false;
    }

    match /duesPeriods/{periodId} {
      allow read: if signedIn();
      allow create, update: if treasurer();
      allow delete: if false;
    }

    match /duesPayments/{paymentId} {
      allow read: if signedIn();
      allow create, update: if treasurer();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create: if hasRole(['ADMIN', 'TREASURER']) && (docId != 'financeSummary' || (request.resource.data.income is int && request.resource.data.expense is int && request.resource.data.expense <= request.resource.data.income));
      allow update: if hasRole(['ADMIN', 'TREASURER']) && docId == 'financeSummary'
        && request.resource.data.income is int && request.resource.data.expense is int
        && request.resource.data.expense <= request.resource.data.income;
      allow update: if hasRole(['ADMIN', 'TREASURER']) && docId != 'financeSummary';
    }

    match /auditLogs/{logId} {
      allow read: if hasRole(['ADMIN']);
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
