rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && userDoc().data.active == true; }
    function hasRole(roles) { return active() && userDoc().data.role in roles; }
    function treasurer() { return hasRole(['ADMIN', 'TREASURER']); }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if hasRole(['ADMIN']);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if active();
      allow create, update: if treasurer();
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if active();
      allow create, update: if treasurer();
      allow delete: if false;
    }

    match /duesPeriods/{periodId} {
      allow read: if active();
      allow create, update: if treasurer();
      allow delete: if false;
    }

    match /duesPayments/{paymentId} {
      allow read: if active();
      allow create, update: if treasurer();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if active();
      allow write: if hasRole(['ADMIN']);
    }

    match /auditLogs/{logId} {
      allow read: if hasRole(['ADMIN']);
      allow create: if active();
      allow update, delete: if false;
    }
  }
}
